# Required for /api/send (token-hidden endpoint)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Optional default chat so body can omit chat_id
#DEFAULT_CHAT_ID=123456789

# Optional: require this secret on every proxy call
# Send as header x-proxy-secret or ?secret=
#PROXY_SECRET=change-me-to-a-long-random-string

# Optional: restrict transparent proxy (/api/bot<token>/...) to these tokens (comma-separated)
#ALLOWED_TOKENS=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
